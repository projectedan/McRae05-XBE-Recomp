#pragma once
#include <cstdint>

namespace std {
inline void* memcpy(void* d, const void* s, size_t n) { return __builtin_memcpy(d, s, n); }
inline void* memmove(void* d, const void* s, size_t n) { return __builtin_memmove(d, s, n); }
inline void* memset(void* d, int v, size_t n) { return __builtin_memset(d, v, n); }
}  // namespace std
